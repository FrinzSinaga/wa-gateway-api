APP_PORT=5000
WEBHOOK_URL=
API_KEY=

# --- Browser (opsional, biasanya tidak perlu diisi) ---
# Path ke Chromium. Kosongkan saja kalau Puppeteer sudah bisa menemukannya.
# Contoh Linux: /usr/bin/chromium
# Contoh Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_BIN=

# Batas waktu menunggu browser connect, dalam milidetik.
# Default gateway 120000. Naikkan kalau server lambat / sering timeout.
PUPPETEER_TIMEOUT=120000

# Batas waktu menunggu balasan perintah browser, dalam milidetik.
PUPPETEER_PROTOCOL_TIMEOUT=180000

# Set true untuk menampilkan log detail Chromium saat launch gagal.
# Berguna untuk diagnosa di server: PUPPETEER_DUMPIO=true npm start
PUPPETEER_DUMPIO=false
